# Akahu personal app credentials (https://my.akahu.nz/developers)
AKAHU_APP_TOKEN=app_token_xxxxxxxxxxxxxxxx
AKAHU_USER_TOKEN=user_token_xxxxxxxxxxxxxxxx

# Leave unset in production. DEMO=1 runs on sample data with no bank connection.
# DEMO=1

PORT=3000
# Where users, sessions and settings are stored (a small JSON file). Mount a persistent volume here.
DATA_DIR=./data
# Set to 1 when running behind HTTPS (any real deployment). Adds Secure cookies and HSTS.
PRODUCTION=1
# Set to 1 if behind a reverse proxy (Fly, Railway, Render) so login rate limiting sees real client IPs.
TRUST_PROXY=1
